/*
/////////////// CHECKS //////////////////
*/


.white-check-prompt {
    margin: 12px 0;
    padding: 14px 18px;
    background: #24332c;
    border-left: 3px solid #8fc4a4;
    border-radius: 10px;
}

.white-check-prompt .check-prompt-header {
    color: #8fc4a4;
}

.white-check-prompt a,
.white-check-retry a {
    display: block;
    color: #b6e3c7;
    font-weight: 600;
    text-decoration: none;
}

.white-check-prompt a:hover,
.white-check-retry a:hover {
    color: #ffffff;
}

.white-check-locked {
    padding: 12px 16px;
    color: #a8b1ab;
    background: #202725;
    border-left: 3px solid #687a70;
    font-size: .8rem;
    letter-spacing: .04em;
}

.white-check-retry {
    margin-top: 12px;
    padding: 12px 16px;
    background: #24332c;
    border-left: 3px solid #8fc4a4;
    border-radius: 8px;
}


@keyframes adamant-pulse {
  0%, 100% {
    text-shadow: 0 0 4px #d8a34b;
  }
  50% {
    text-shadow: 0 0 18px #f0b35a;
  }
}

.red-check-prompt {
  	position: relative;
    margin: 12px 0;
    padding: 14px 18px;
    background: #302022;
    border-left: 3px solid #d15a5a;
    border-radius: 10px;
    transition: background .2s, box-shadow .2s;
}

.red-check-prompt:hover {
    background: #402629;
    box-shadow: 0 0 12px rgba(209, 90, 90, .15);
}

.check-prompt-header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .08em;
    color: #e8aaaa;
}

.red-check-prompt a {
    display: block;
    color: #f2d3d3;
    font-weight: 600;
    text-decoration: none;
}

.red-check-prompt a:hover {
    color: #ffffff;
    text-decoration: none;
}


.active-check-result {
