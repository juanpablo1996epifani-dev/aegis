:: Story Stylesheet [stylesheet]
/* gold color: #f0b35a;
 cyan color: #8abebe;
*/
html {
	color: #8abebe;
}

h3 {
	margin: 0;
  color: #f0b35a;
}

strong {
	text-transform: capitalize;
}

.gap-2 {
	gap: 8px;
}

.d-flex {
	display: flex;
}

.justify-content-between {
	justify-content: space-between;
}

.narrative-continue {
    margin: 32px 0;
    text-align: center;
}

.narrative-continue a {
    color: #8abebe;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-decoration: none;
    cursor: pointer;
}

.narrative-continue a:hover {
    color: #f0b35a;
}

.narrative-section {
    text-align: left;
    animation: narrative-reveal 0.7s ease-out both;
}

@keyframes narrative-reveal {
    from {
        opacity: 0;
        transform: translateY(12px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


.container-class {
    position: relative;
    transition: background-color .2s, border-color .2s;
}

.container-class:hover {
    border-color: #f0b35a;
    background-color: #21344a;
}

.container-class .macro-link {
    display: flex;
    align-items: flex-end;
    justify-content: center;

    position: absolute;
    inset: 0;

    padding: 16px;
    box-sizing: border-box;

    color: #f0b35a;
    text-decoration: none;
    cursor: pointer;
}

.container-class .macro-link:hover {
    color: #f0b35a;
}

.adamant-prompt.link-replace {
