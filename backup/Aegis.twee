:: Story JavaScript [script]
setup.disciplines = {
  adamant: {
    id: "adamant",
    name: "The Adamant",
    title: "The Voice of Matter",
    color: "#f0b35a",
    skills: {
      strength: {
        name: "Strength",
        description: "Force, leverage, physical dominance. The voice of the core which will always urge you to keep your temple clean."
      },
      endurance: {
        name: "Endurance",
        description: "Pain, exhaustion, physical persistence. The voice of the heart and its blood vessels which will always try to keep them running."
      },
      chemestry: {
        name: "Chemestry",
        description: "Skin, touch, taste and smell. The voice of your body connecting to the outside in search for gratification."
      },
      composure: {
        name: "Composure",
        description: "Control over bodily fear, panic, and stress. It will center you, temper your like steel. Unbending."
      },
      ferocity: {
        name: "Ferocity",
        description: "Aggressive instinct, confrontation, intimidation. The voice of your terror personified and proyected onto others."
      }
    }
  },

  noetarch: {
    id: "noetarch",
    name: "The Noetarch",
    title: "The Voice of Reason",
    color: "#8abebe",
    skills: {
      analysis: {
        name: "Analysis",
        description: "Logic, inference, contradictions. The voice of mind, connecting the world and its patterns which will be spelled out to you."
      },
      engineering: {
        name: "Engineering",
        description: "Machinery, technical systems, practical science. Your overall experience with both the tools and their language, the tech-guy inside you."
      },
      rhetoric: {
        name: "Rhetoric",
        description: "Persuasion, argument, manipulation of ideas. The voice of compromise and suggestion, dominate an argument through subtelty."
      },
      reaction: {
        name: "Reaction",
        description: "Mind capacity for quick understanding. The voice of pre-calculation or the power to reconstruct."
      },
      erudition: {
        name: "Erudition",
        description: "History, culture, scholarship, remembered knowledge. The voice of the past stirring memories in the large soup of your mind."
      }
    }
  },

  anamnesist: {
    id: "anamnesist",
    name: "The Anamnesist",
    title: "The Voice of the Unseen",
    color: "#c5a1e7",
    skills: {
      resonance: {
        name: "Resonance",
        description: "Sensitivity to the Immaterium and its disturbances. The voice of the void and the inky blackness, and what lies beyond."
      },
      intuition: {
        name: "Intuition",
        description: "Conclusions formed without conscious reasoning. The voice of the conceptualized world, using hunches and gut feelings to create the path."
      },
      oneirology: {
        name: "Oneirology",
        description: "Dreams, subconscious imagery, buried memories. The voice of the underworld translated to you by yours truly. It may also speak in reality."
      },
      empathy: {
        name: "Empathy",
        description: "Emotional perception, understanding other minds. The soft voice of the kindest of you and the weakest of all, revealing everyone's feelings and weakpoints."
      },
      dissociation: {
        name: "Dissociation",
        description: "Detachment from the self and ordinary perception. The voice of the insane, high on this world you live in. It will drown your reason with madness."
      }
    }
  }
};


setup.characterPresets = {
    adamant: {
        name: "The Unyielding",
        adamant: 4,
        noetarch: 1,
        anamnesist: 2
    },
    noetarch: {
        name: "The Scholar",
        adamant: 2,
        noetarch: 4,
        anamnesist: 1
    },
    anamnesist: {
        name: "The Seer",
        adamant: 1,
        noetarch: 2,
        anamnesist: 4
    }
};

setup.applyCharacterPreset = function (id) {
    const preset = setup.characterPresets[id];

    if (!preset) {
        throw new Error(`Unknown preset: ${id}`);
    }

    const character = State.variables.character;

    character.archetype = id;

    for (const disciplineId of [
        "adamant",
        "noetarch",
        "anamnesist"
    ]) {
        character.disciplines[disciplineId].level =
            preset[disciplineId];
    }
};

/* ROLL SKILLS CHECKS! */

setup.rollSkill = function (disciplineId, skillId, threshold) {
  const discipline = State.variables.character
    .disciplines[disciplineId];

  const modifier = discipline.skills[skillId];

  const die1 = Math.floor(Math.random() * 6) + 1;
  const die2 = Math.floor(Math.random() * 6) + 1;

  const total = die1 + die2 + modifier;

  return {
    die1,
    die2,
    modifier,
    total,
    threshold,
    success: total >= threshold
  };
};


/* ======================================
   ACTIVE CHECKS
   ====================================== */

setup.activeChecks = {};


/* ======================================
  CHAPTER 0 — AWAKENING 
   ====================================== */


setup.activeChecks["awakening.who_am_i"] = {
    id: "awakening.who_am_i",
    type: "RED",
    discipline: "anamnesist",
    skill: "intuition",
    threshold: 10,
    successPassage: "Awakening_WhoSuccess",
    failurePassage: "Awakening_WhoFailure"
};

setup.activeChecks["awakening.what_am_i"] = {
    id: "awakening.what_am_i",
    type: "RED",
    discipline: "noetarch",
    skill: "erudition",
    threshold: 10,
    successPassage: "Awakening.What_Am_I_Success",
    failurePassage: "Awakening.What_Am_I_Failure"
};


setup.activeChecks["awakening.analyze.find_out_more"] = {
    id: "awakening.analyze.find_out_more",
    type: "WHITE",
    discipline: "noetarch",
    skill: "analysis",
    threshold: 12,
    successPassage: "Awakening_Analyze_Success",
    failurePassage: "Awakening_Analyze_Failure"
};





/* END OF ACTIVE CHECKS */


setup.canRetryWhiteCheck = function (checkId) {
    const check = setup.activeChecks[checkId];
    const previous = State.variables.checks?.[checkId];

    if (!check || check.type !== "WHITE") {
        return false;
    }

    if (!previous || previous.success) {
        return false;
    }

    const discipline =
        State.variables.character.disciplines[check.discipline];

    const currentSkill = discipline?.skills?.[check.skill];

    return (
        typeof currentSkill === "number" &&
        currentSkill > previous.skillAtAttempt
    );
};

setup.resolveActiveCheck = function (checkId) {
    const check = setup.activeChecks[checkId];

    if (!check) {
        throw new Error(`Unknown check: ${checkId}`);
    }

    const state = State.variables;
    const previous = state.checks[checkId];

    // Completed checks and RED checks never reroll.
    if (previous) {
        if (check.type === "RED" || previous.success) {
            return previous;
        }

        // A failed WHITE check requires a retry unlock.
        if (!setup.canRetryWhiteCheck(checkId)) {
            return previous;
        }
    }

    const characterDiscipline =
        state.character.disciplines[check.discipline];

    if (!characterDiscipline) {
        throw new Error(`Unknown discipline: ${check.discipline}`);
    }

    const discipline = characterDiscipline.level;
    const skill = characterDiscipline.skills[check.skill];

    if (typeof discipline !== "number" ||
        typeof skill !== "number") {
        throw new Error(`Invalid skill: ${check.skill}`);
    }

    const dice = [random(1, 6), random(1, 6)];

    const total = dice[0] + dice[1] + discipline + skill;

    const result = {
        id: checkId,
        type: check.type,
        dice,
        discipline,
        skill,
        skillAtAttempt: skill,
        total,
        threshold: check.threshold,
        success: total >= check.threshold,
        attempts: (previous?.attempts || 0) + 1
    };

    state.checks[checkId] = result;

    return result;
};



/* UI */


setup.openPanel = function (title, passageName) {
    if (!Story.has(passageName)) {
        console.error("UI passage not found:", passageName);
        return;
    }

    if (passageName === "UI_Skills") {
        setup.resetSkillDraft();
    }

    Dialog
        .create(title, "aegis-panel")
        .wikiPassage(passageName)
        .open();
};


/* ======================================
   EXPERIENCE AND PROGRESSION
   ====================================== */

setup.EXP_THRESHOLD = 100;

setup.addSkillPoint = function (amount = 1) {
    if (!Number.isInteger(amount) || amount <= 0) {
        return false;
    }

    State.variables.character.skillPoints += amount;

    return true;
};

setup.addExperiencePoints = function (amount) {
    if (!Number.isInteger(amount) || amount <= 0) {
        return false;
    }

    const character = State.variables.character;

    character.exp += amount;

    const earnedPoints = Math.floor(
        character.exp / setup.EXP_THRESHOLD
    );

    if (earnedPoints > 0) {
        setup.addSkillPoint(earnedPoints);
        character.exp %= setup.EXP_THRESHOLD;
    }

    return true;
};

setup.upgradeSkill = function (disciplineId, skillId) {
    const character = State.variables.character;
    const discipline = character.disciplines[disciplineId];

    if (
        !discipline ||
        typeof discipline.skills[skillId] !== "number" ||
        character.skillPoints <= 0
    ) {
        return false;
    }

    discipline.skills[skillId] += 1;
    character.skillPoints -= 1;

    return true;
};


/* ======================================
   SKILL ALLOCATION
   ====================================== */

setup.resetSkillDraft = function () {
    State.temporary.skillDraft = {};
};

setup.getSkillDraft = function (disciplineId, skillId) {
    const key = `${disciplineId}.${skillId}`;
    return State.temporary.skillDraft?.[key] || 0;
};

setup.getSkillDraftTotal = function () {
    return Object.values(
        State.temporary.skillDraft || {}
    ).reduce((sum, value) => sum + value, 0);
};

setup.getRemainingSkillPoints = function () {
    return State.variables.character.skillInc
        - setup.getSkillDraftTotal();
};

setup.stageSkillUpgrade = function (
    disciplineId,
    skillId,
    change
) {
    if (change !== 1 && change !== -1) {
        return false;
    }

    const character = State.variables.character;
    const skill = character.disciplines?.[disciplineId]
        ?.skills?.[skillId];

    if (typeof skill !== "number") {
        return false;
    }

    const draft = State.temporary.skillDraft || {};
    const key = `${disciplineId}.${skillId}`;
    const current = draft[key] || 0;

    if (change > 0 &&
        setup.getRemainingSkillPoints() <= 0) {
        return false;
    }

    if (current + change < 0) {
        return false;
    }

    draft[key] = current + change;

    if (draft[key] === 0) {
        delete draft[key];
    }

    State.temporary.skillDraft = draft;
    return true;
};

setup.confirmSkillDraft = function () {
    const character = State.variables.character;
    const draft = State.temporary.skillDraft || {};
    const entries = Object.entries(draft);
    const total = setup.getSkillDraftTotal();

    if (total <= 0 || total > character.skillInc) {
        return false;
    }

    // Validate everything before spending anything.
    for (const [key, amount] of entries) {
        const [disciplineId, skillId] = key.split(".");
        const skill = character.disciplines?.[disciplineId]
            ?.skills?.[skillId];

        if (!Number.isInteger(amount) ||
            amount <= 0 ||
            typeof skill !== "number") {
            return false;
        }
    }

    // Commit all upgrades.
    for (const [key, amount] of entries) {
        const [disciplineId, skillId] = key.split(".");

        character.disciplines[disciplineId]
            .skills[skillId] += amount;
    }

    character.skillInc -= total;
    setup.resetSkillDraft();

    return true;
};


